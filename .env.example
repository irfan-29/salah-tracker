# --- Auth / sessions (REQUIRED in production) ---
# Used to sign the session cookie and the anonymous guest cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
COOKIE_SECRET=
SESSION_SECRET=

# --- Telegram ---
# One shared app bot. Users only supply their own chat ID in Settings.
# Get it from @BotFather.
TELEGRAM_BOT_TOKEN=

# --- Database ---
# Defaults to the existing Atlas cluster if unset.
MONGO_URI=

# --- Scheduler (Upstash QStash) ---
# QStash drives POST /api/qstash/sweep on a fixed interval. Requests are
# authenticated by their Upstash-Signature, so there is no shared secret to
# leak - anyone hitting the URL without a valid signature gets 401.
#
# All four values come from https://console.upstash.com/qstash. Set them as
# Vercel environment variables (production), and in .env to run the CLI.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Public base URL of the deployed app. Used to build the destination URL and to
# verify the signature's URL claim, so it must match exactly.
QSTASH_APP_URL=

# Optional. How often the sweep runs.
#
#   COST WARNING: QStash's free tier is 1,000 messages/day and bills every
#   delivery attempt, retries included. Cost is therefore:
#       ticks/day * (1 + retries)
#   The schedule pins retries to 1, so:
#       */10 (default) -> 144/day typical, 288/day worst case  (29% of free tier)
#       */15           ->  96/day typical, 192/day worst case
#       */5            -> 288/day typical, 576/day worst case  (tighter, but fits)
#
#   Never go finer than */5 without redoing this arithmetic: past that point a
#   day where deliveries fail starts exceeding the free tier and gets billed.
QSTASH_SWEEP_CRON=*/10 * * * *

# After deploying, register the schedule once (free - registration is not a
# billed message; only deliveries are):
#
#   npm run qstash:schedule -- status   # show current schedule + cost
#   npm run qstash:schedule -- create   # upsert; safe to run twice
#   npm run qstash:schedule -- delete   # stop all billed deliveries
