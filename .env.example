# --- Auth / sessions (REQUIRED in production) ---
# Used to sign the session cookie and the anonymous guest cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
COOKIE_SECRET=
SESSION_SECRET=

# --- Telegram ---
# One shared app bot. Users only supply their own chat ID in Settings.
# Get it from @BotFather.
TELEGRAM_BOT_TOKEN=

# --- Database ---
# Defaults to the existing Atlas cluster if unset.
MONGO_URI=

# --- Scheduler ---
# Shared secret for GET /api/due-notifications/sweep. Required in production;
# the endpoint refuses to run without it so nobody else can trigger a send for
# every subscriber. Pass it as ?key=... or an Authorization: Bearer header.
CRON_SECRET=
