# --- Auth / sessions (REQUIRED in production) ---
# Used to sign the session cookie and the anonymous guest cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
COOKIE_SECRET=
SESSION_SECRET=

# --- Telegram ---
# One shared app bot. Users only supply their own chat ID in Settings.
# Get it from @BotFather.
TELEGRAM_BOT_TOKEN=

# --- Email (signup OTP verification) ---
# Signup creates no account until a 6-digit code is confirmed, so an address has
# to be proven before it can be claimed.
#
# Pick ONE transport with EMAIL_PROVIDER: gmail | resend | auto (default).
# "auto" uses Gmail when GMAIL_APP_PASSWORD is set, else Resend.
EMAIL_PROVIDER=gmail

# --- Gmail (no domain required) ---
# Sends from a normal Gmail address over SMTP. Gmail will only accept the exact
# address you authenticate as.
#
# Requires 2FA on that Google account:
#   1. Enable 2-Step Verification on the Google account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an App Password for "Mail"
#   4. Paste the 16-character password below (spaces are stripped for you)
#
# Google only issues App Passwords when 2FA is on, and rejects SMTP login with
# the account's real password.
GMAIL_USER=mdirfan29pro@gmail.com
GMAIL_APP_PASSWORD=
# Shown as the sender name, e.g. "Salah Tracker <mdirfan29pro@gmail.com>".
GMAIL_FROM_NAME=Salah Tracker
#
# Limits to know about: consumer Gmail is capped around 500 messages/day, and
# because there is no SPF/DKIM for a gmail.com sender, some OTP mail will be
# filtered into spam. Fine for a personal app; revisit if signups grow.

# --- Resend (needs a domain you control) ---
# Better deliverability and higher limits, but Resend will only send from
# domains verified in its dashboard - onboarding@resend.dev delivers solely to
# the account's own inbox, so it cannot be used for real signups.
# Keys: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM=Salah Tracker <hello@yourdomain.com>

# Never enable this in production. With no transport configured it makes the app
# print the OTP to its own log instead of sending it, which is how the signup
# flow is exercised locally. Gated on NODE_ENV too, but this flag alone should
# never be turned on in a deploy.
OTP_DEV_ECHO=false

# --- Database ---
# REQUIRED. The app refuses to boot without it - there is deliberately no
# hard-coded fallback, because that is how a live credential ended up in this
# repository's history.
#
# Atlas -> Database Access -> the app's user -> "Connect" copies the URI. Keep the
# database name after the host:
#   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/salahDB
#
# Rotate the password before using it: the previous one is public (it has been
# committed since the first commit).
MONGO_URI=

# --- Scheduler (Upstash QStash) ---
# QStash drives POST /api/qstash/sweep on a fixed interval. Requests are
# authenticated by their Upstash-Signature, so there is no shared secret to
# leak - anyone hitting the URL without a valid signature gets 401.
#
# All five values come from the .env block at https://console.upstash.com/qstash.
# Set them as Vercel environment variables (production), and in .env to run the CLI.
QSTASH_TOKEN=
# Region-specific API URL, e.g. https://qstash-us-east-1.upstash.io. Required:
# without it the SDK falls back to the global endpoint, which rejects a
# region-specific token with an error that looks like bad credentials.
QSTASH_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Public base URL of the deployed app. Used to build the destination URL and to
# verify the signature's URL claim, so it must match exactly.
QSTASH_APP_URL=

# Optional. How often the sweep runs.
#
#   COST WARNING: QStash's free tier is 1,000 messages/day and bills every
#   delivery attempt, retries included. Cost is therefore:
#       ticks/day * (1 + retries)
#   The schedule pins retries to 1, so:
#       */10 (default) -> 144/day typical, 288/day worst case  (29% of free tier)
#       */15           ->  96/day typical, 192/day worst case
#       */5            -> 288/day typical, 576/day worst case  (tighter, but fits)
#
#   Never go finer than */5 without redoing this arithmetic: past that point a
#   day where deliveries fail starts exceeding the free tier and gets billed.
QSTASH_SWEEP_CRON=*/10 * * * *

# After deploying, register the schedule once (free - registration is not a
# billed message; only deliveries are):
#
#   npm run qstash:schedule -- status   # show current schedule + cost
#   npm run qstash:schedule -- create   # upsert; safe to run twice
#   npm run qstash:schedule -- delete   # stop all billed deliveries
