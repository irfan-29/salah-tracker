<%- include("navbar") -%>

<div class="page-header">
  <h1>Account</h1>
  <p>Your identity in Salah Tracker</p>
</div>

<% if (usernameError) { %>
  <div class="auth-alert" role="alert">
    <span class="material-symbols-rounded">error</span>
    <%= usernameError %>
  </div>
<% } %>
<% if (usernameOk) { %>
  <div class="auth-alert auth-alert-ok" role="status">
    <span class="material-symbols-rounded">check_circle</span>
    Username updated.
  </div>
<% } %>

<section class="account-card">
  <%# Letter avatar, matching the nav and the public profile. A Google or
      uploaded image is deliberately not used here: a Google photo needs OAuth,
      and Google profile photos are not Gravatars, so the only options that
      actually work are a file upload or a second sign-in path. Revisit if a
      real need appears. %>
  <div class="account-avatar" aria-hidden="true"><%= displayName.charAt(0).toUpperCase() %></div>

  <div class="account-body">
    <div class="account-handle"><%= displayName %></div>
    <div class="account-sub">
      <% if (username) { %>
        <a href="/u/<%= username %>" target="_blank" rel="noopener">/u/<%= username %></a>
      <% } else { %>
        No username yet - set one below to get a shareable profile link.
      <% } %>
    </div>
  </div>
</section>

<section class="account-card">
  <div class="account-field">
    <label class="account-label" for="inputUsername">Username</label>
    <p class="account-hint">
      This is your public handle. It appears on your posts and is how people
      find you at <code>/u/&lt;username&gt;</code>. Changing it breaks links
      people have already shared.
    </p>
    <form action="/settings/username" method="POST" class="username-input">
      <input class="form-control" type="text" name="username" id="inputUsername"
             value="<%= username || '' %>" placeholder="your-name"
             pattern="[a-zA-Z0-9._]{3,30}" maxlength="30" required
             autocomplete="off" autocapitalize="none" spellcheck="false">
      <button type="submit" class="btn btn-primary">
        <span class="material-symbols-rounded">check</span>
        Update
      </button>
    </form>
  </div>
</section>

<section class="account-card">
  <div class="account-field">
    <label class="account-label">Email address</label>
    <p class="account-hint">
      <% if (verified) { %>
        <span class="account-verified">
          <span class="material-symbols-rounded">verified</span>
          Verified
        </span>
      <% } else { %>
        <span class="account-unverified">
          <span class="material-symbols-rounded">info</span>
          Not verified
        </span>
        &mdash; this address predates email verification.
      <% } %>
    </p>
    <div class="account-value"><%= email %></div>
    <p class="account-hint">
      Your email is only used to sign in and to receive verification codes. It is
      never shown on your posts or your public profile.
    </p>
  </div>
</section>

<%- include('footer') %>