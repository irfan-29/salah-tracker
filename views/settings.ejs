<%- include("navbar") -%>

<div class="page-header">
  <h1>Settings</h1>
  <p>Customize your experience</p>
</div>

<div class="container1 settings-form">
  <form action="/settings" method="POST">
    <input type="hidden" name="redirectTo" value="/settings">

    <div class="form-section-title">Appearance</div>
    <div class="theme-picker">
      <label class="theme-picker-option <%= theme === 'light' ? 'active' : '' %>">
        <input type="radio" name="theme" value="light" <%= theme === 'light' ? 'checked' : '' %>>
        <span class="material-symbols-rounded">light_mode</span>
        <span>Light</span>
      </label>
      <label class="theme-picker-option <%= theme === 'dark' ? 'active' : '' %>">
        <input type="radio" name="theme" value="dark" <%= theme === 'dark' ? 'checked' : '' %>>
        <span class="material-symbols-rounded">dark_mode</span>
        <span>Dark</span>
      </label>
    </div>

    <div class="form-section-title">Default Home Page</div>
    <div class="custom-select-wrapper">
      <% const homeLabels={ 'salah' : 'Salah' , 'quran' : 'Quran' , 'audio' : 'Audio' , 'salah-tracker' : 'Salah Tracker'
          , 'salah-timings' : 'Salah Timings' , 'challenges' : 'Challenges' , 'analytics' : 'Analytics' , 'posts' : 'Posts'
          , 'settings' : 'Settings' }; %>
      <div class="custom-selector form-control d-flex align-items-center justify-content-between" data-field="Home">
        <span id="labelHome"><%= homeLabels[defaultHome] || defaultHome %></span>
        <span class="material-symbols-rounded" style="opacity: 0.5;">expand_more</span>
      </div>
      <div id="dropdownHome" class="custom-dropdown-menu">
        <div class="options-list">
          <% Object.keys(homeLabels).forEach(opt=> { %>
            <div class="option-item-custom" data-field="Home" data-value="<%= opt %>"><%= homeLabels[opt] %></div>
          <% }); %>
        </div>
      </div>
      <input type="hidden" name="defaultHome" id="inputHome" value="<%= defaultHome %>">
    </div>

    <div class="form-section-title">Quran Font</div>
    <div class="custom-select-wrapper">
      <div class="custom-selector form-control d-flex align-items-center justify-content-between" data-field="ArabicFont">
        <span id="labelArabicFont"><%= tarteelFonts[favoriteFont]?.label || 'Choose Font' %></span>
        <span class="material-symbols-rounded" style="opacity: 0.5;">expand_more</span>
      </div>
      <div id="dropdownArabicFont" class="custom-dropdown-menu">
        <div class="options-list" style="max-height: 400px; overflow-y: auto;">
          <% Object.keys(tarteelFonts).forEach(id=> { %>
            <div class="option-item-custom d-flex justify-content-between align-items-center" data-field="ArabicFont" data-value="<%= id %>">
              <div>
                <div style="font-weight: 600;"><%= tarteelFonts[id].label %></div>
                <span class="badge badge-primary" style="font-size: 0.65rem;"><%= tarteelFonts[id].tag %></span>
              </div>
              <span dir="rtl" style="font-family: '<%= id %>'; font-size: 1.5rem;">بِسْمِ اللهِ</span>
            </div>
          <% }); %>
        </div>
      </div>
      <input type="hidden" name="font" id="inputArabicFont" value="<%= favoriteFont %>">
    </div>

    <div class="form-section-title">Reciter</div>
    <div class="custom-select-wrapper">
      <div class="custom-selector form-control d-flex align-items-center justify-content-between" data-field="Reciter">
        <span id="labelReciter"><%= reciters[favoriteReciter] %></span>
        <span class="material-symbols-rounded" style="opacity: 0.5;">expand_more</span>
      </div>
      <div id="dropdownReciter" class="custom-dropdown-menu">
        <input type="text" class="dropdown-search-custom" placeholder="Search Reciter...">
        <div class="options-list" style="max-height: 250px; overflow-y: auto;">
          <% Object.keys(reciters).forEach(function(key) { %>
            <div class="option-item-custom" data-field="Reciter" data-value="<%= key %>"><%= reciters[key] %></div>
          <% }); %>
        </div>
      </div>
      <input type="hidden" name="reciter" id="inputReciter" value="<%= favoriteReciter %>">
    </div>

    <div class="form-section-title">Translation Editions</div>
    <div class="custom-select-wrapper">
      <div id="selectedEditionContainer" class="custom-selector form-control d-flex flex-wrap align-items-center gap-2" style="min-height: 58px; cursor: pointer;">
        <span id="editionPlaceholder" class="text-muted">Select preferred Quran editions</span>
      </div>
      <div id="dropdownContainer" class="custom-dropdown-menu" style="max-height: 350px; overflow-y: auto;">
        <input type="text" id="searchEdition" class="dropdown-search-custom" placeholder="Search language or author...">
        <div id="editionOptions">
          <% Object.keys(editions).forEach(function(language) { %>
            <div class="language-group">
              <div class="p-2 bg-light small text-muted language-label"><%= language %></div>
              <% editions[language].forEach(function(edition) { %>
                <div class="option-item-custom option-item" data-value="<%= edition.name %>" data-author="<%= edition.author %>" data-language="<%= language %>" style="cursor: pointer;">
                  <%= edition.author %>
                </div>
              <% }); %>
            </div>
          <% }); %>
        </div>
      </div>
      <input type="hidden" name="edition" id="edition" required>
    </div>

    <div class="form-section-title">Primary Translation</div>
    <p class="form-section-hint">Shown on Ayah of the Day and listed first on the surah page.</p>
    <div class="custom-select-wrapper">
      <div class="custom-selector form-control d-flex align-items-center justify-content-between" data-field="PrimaryTranslation">
        <span id="labelPrimaryTranslation">Select editions first</span>
        <span class="material-symbols-rounded" style="opacity: 0.5;">expand_more</span>
      </div>
      <div id="dropdownPrimaryTranslation" class="custom-dropdown-menu">
        <div class="options-list" id="primaryTranslationOptions"></div>
      </div>
      <input type="hidden" name="primaryTranslation" id="inputPrimaryTranslation" value="<%= primaryTranslation || '' %>">
    </div>

    <div class="form-section-title">Location</div>
    <div class="custom-select-wrapper">
      <div class="custom-selector form-control d-flex align-items-center justify-content-between" data-field="Location">
        <span id="labelLocation"><%= location %></span>
        <span class="material-symbols-rounded" style="opacity: 0.5;">expand_more</span>
      </div>
      <div id="dropdownLocation" class="custom-dropdown-menu">
        <input type="text" class="dropdown-search-custom" placeholder="Search Location...">
        <div class="options-list">
          <% ['Coimbatore', 'Hosur', 'Salem', 'Ramanathapuram', 'Bengaluru'].forEach(loc => { %>
            <div class="option-item-custom" data-field="Location" data-value="<%= loc %>"><%= loc %></div>
          <% }); %>
        </div>
      </div>
      <input type="hidden" name="location" id="inputLocation" value="<%= location %>">
    </div>

    <div class="form-section-title">Telegram Notifications</div>

    <div class="tg-row tg-row-head">
      <div>
        <div class="tg-title">Telegram notifications</div>
        <div class="tg-sub">Daily reminders and streak summaries</div>
      </div>
      <% if (isLoggedIn) { %>
      <label class="tg-switch">
        <input type="checkbox" name="tgEnabled" <%= tgPrefs.enabled ? 'checked' : '' %>>
        <span class="tg-slider"></span>
      </label>
      <% } else { %>
      <!-- Signed out: only the switch is unavailable. The label stays readable so
           the feature is discoverable rather than hidden. -->
      <label class="tg-switch tg-switch-locked" aria-disabled="true" title="Sign in to enable">
        <input type="checkbox" disabled>
        <span class="tg-slider"></span>
        <span class="tg-lock-dot material-symbols-rounded" aria-hidden="true">lock</span>
      </label>
      <% } %>
    </div>

    <% if (!isLoggedIn) { %>
      <div class="tg-locked-note">
        <span class="material-symbols-rounded">lock</span>
        <a href="/login">Sign in</a> to turn on Telegram notifications.
      </div>
    <% } else { %>

    <% if (typeof botConfigured !== 'undefined' && !botConfigured) { %>
      <div class="wa-status wa-status-bad">
        <span class="material-symbols-rounded">error</span>
        Notifications are off: the app's Telegram bot isn't configured on the server yet.
      </div>
    <% } %>

    <% if (tgPrefs.enabled && !tgPrefs.chatId) { %>
      <!-- Enabled but not connected yet: show the setup steps. -->
      <div class="tg-steps">
        <div class="tg-step"><span class="tg-step-n">1</span>
          <span>Open <a href="https://t.me/SalahTracker_UMI_Bot" target="_blank" rel="noopener">the Salah Tracker bot</a> in Telegram.</span>
        </div>
        <div class="tg-step"><span class="tg-step-n">2</span>
          <span>Press <strong>Get setup code</strong> below and send the code to the bot.</span>
        </div>
        <div class="tg-step"><span class="tg-step-n">3</span>
          <span>Press <strong>Connect</strong>.</span>
        </div>
      </div>

      <% if (typeof tgSetupCode !== 'undefined' && tgSetupCode) { %>
        <div class="wa-status wa-status-ok">
          <span class="material-symbols-rounded">key</span>
          Send this code to the bot, then press Connect:
          <strong class="tg-code"><%= tgSetupCode %></strong>
        </div>
      <% } %>
    <% } %>

    <% if (tgPrefs.enabled && tgPrefs.chatId) { %>
      <div class="wa-status wa-status-ok">
        <span class="material-symbols-rounded">check_circle</span>
        Connected to chat <strong><%= tgPrefs.chatId %></strong>.
      </div>

      <div class="tg-modules">
        <div class="tg-title tg-title-sm">What to send</div>

        <%# Each module: an enable checkbox plus its own "Send now" button.
            The button uses formaction so it posts this form to /test-telegram
            instead of saving - which avoids nesting a second <form> (browsers
            ignore those, which broke the chat-id lookup earlier). %>
        <div class="tg-module">
          <label class="tg-row tg-row-module">
            <input type="checkbox" name="tgEventChallenges" <%= tgPrefs.events.challenges ? 'checked' : '' %>>
            <span class="tg-check material-symbols-rounded" aria-hidden="true"></span>
            <span><strong>Challenges</strong><em>Sent when you update your streaks</em></span>
          </label>
          <button type="submit" class="tg-send-btn" formaction="/test-telegram" name="module" value="challenges"
                  title="Send a Challenges notification now">
            <span class="material-symbols-rounded">send</span>Send now
          </button>
        </div>

        <div class="tg-module">
          <label class="tg-row tg-row-module">
            <input type="checkbox" name="tgEventSalahTracker" <%= tgPrefs.events.salahTracker ? 'checked' : '' %>>
            <span class="tg-check material-symbols-rounded" aria-hidden="true"></span>
            <span><strong>Salah Tracker</strong><em>Sent when you log a prayer</em></span>
          </label>
          <button type="submit" class="tg-send-btn" formaction="/test-telegram" name="module" value="salahTracker"
                  title="Send a Salah Tracker notification now">
            <span class="material-symbols-rounded">send</span>Send now
          </button>
        </div>

        <div class="tg-module">
          <label class="tg-row tg-row-module">
            <input type="checkbox" name="tgEventNewPost" <%= tgPrefs.events.newPost ? 'checked' : '' %>>
            <span class="tg-check material-symbols-rounded" aria-hidden="true"></span>
            <span><strong>New post</strong><em>When a post or video is added</em></span>
          </label>
          <button type="submit" class="tg-send-btn" formaction="/test-telegram" name="module" value="newPost"
                  title="Send a New post notification now">
            <span class="material-symbols-rounded">send</span>Send now
          </button>
        </div>

        <div class="tg-module">
          <label class="tg-row tg-row-module">
            <input type="checkbox" name="tgEventSalahTimings" <%= tgPrefs.events.salahTimings ? 'checked' : '' %>>
            <span class="tg-check material-symbols-rounded" aria-hidden="true"></span>
            <span><strong>Salah timings</strong><em>Sent once a day</em></span>
          </label>
          <button type="submit" class="tg-send-btn" formaction="/test-telegram" name="module" value="salahTimings"
                  title="Send today's Salah timings now">
            <span class="material-symbols-rounded">send</span>Send now
          </button>
          <% if (tgPrefs.events.salahTimings) { %>
          <div class="form-floating tg-time">
            <input class="form-control" type="time" id="tgSalahTime" name="tgSalahTime" value="<%= tgPrefs.times.salahTimings %>">
            <label for="tgSalahTime">Send at</label>
          </div>
          <% } %>
        </div>

        <div class="tg-module">
          <label class="tg-row tg-row-module">
            <input type="checkbox" name="tgEventAyah" <%= tgPrefs.events.ayahOfTheDay ? 'checked' : '' %>>
            <span class="tg-check material-symbols-rounded" aria-hidden="true"></span>
            <span><strong>Ayah of the day</strong><em>Sent once a day</em></span>
          </label>
          <button type="submit" class="tg-send-btn" formaction="/test-telegram" name="module" value="ayahOfTheDay"
                  title="Send today's Ayah of the day now">
            <span class="material-symbols-rounded">send</span>Send now
          </button>
          <% if (tgPrefs.events.ayahOfTheDay) { %>
          <div class="form-floating tg-time">
            <input class="form-control" type="time" id="tgAyahTime" name="tgAyahTime" value="<%= tgPrefs.times.ayahOfTheDay %>">
            <label for="tgAyahTime">Send at</label>
          </div>
          <% } %>
        </div>
      </div>

      <p class="form-section-hint">
        Times are in your own timezone (<%= tgPrefs.timezone %>). A message is sent
        the first time you open the app after its time.
      </p>
    <% } %>

    <input type="hidden" id="tgTimezoneField" name="tgTimezone" value="<%= tgPrefs.timezone %>">
    <% } %>

    <div class="new-task" style="margin-top: 1.5rem; display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center;">
      <button type="submit" class="btn btn-primary" value="add" name="add">Save Settings</button>
    </div>
  </form>

  <%# Everything below is connection state, so it only exists once notifications
      are actually switched on. %>
  <% if (isLoggedIn && tgPrefs.enabled) { %>
    <% if (!tgPrefs.chatId) { %>
    <div class="wa-test-form">
      <form action="/telegram-setup-code" method="POST" style="display:inline">
        <input type="hidden" name="redirectTo" value="/settings">
        <button type="submit" class="btn btn-primary">
          <span class="material-symbols-rounded">key</span>
          Get setup code
        </button>
      </form>
      <form action="/telegram-chat-id" method="POST" style="display:inline">
        <input type="hidden" name="redirectTo" value="/settings">
        <button type="submit" class="btn btn-outline">
          <span class="material-symbols-rounded">link</span>
          Connect
        </button>
      </form>
    </div>
    <% } %>
  <% } %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  // Delivery times are stored in the visitor's own timezone, but the server has
  // no way to know it - so read it from the browser and submit it with the form.
  const tzField = document.getElementById('tgTimezoneField');
  if (tzField) {
    try {
      const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
      if (tz) tzField.value = tz;
    } catch (e) { /* keep the stored value */ }
  }

  document.querySelectorAll('.theme-picker-option input').forEach(radio => {
    radio.addEventListener('change', function () {
      document.querySelectorAll('.theme-picker-option').forEach(opt => opt.classList.remove('active'));
      this.closest('.theme-picker-option').classList.add('active');
      document.documentElement.setAttribute('data-theme', this.value);
    });
  });

  function markCustomDropdown(field, currentVal) {
    const dropdown = document.getElementById('dropdown' + field);
    if (!dropdown) return;
    dropdown.querySelectorAll('.option-item-custom').forEach(opt => {
      opt.classList.toggle('selected-highlight', opt.getAttribute('data-value') === currentVal);
    });
  }

  ['Home', 'Reciter', 'Location', 'ArabicFont'].forEach(field => {
    const hiddenInput = document.getElementById('input' + field);
    if (hiddenInput) markCustomDropdown(field, hiddenInput.value);
  });

  document.querySelectorAll('.custom-selector[data-field]').forEach(el => {
    el.addEventListener('click', function () {
      const field = this.getAttribute('data-field');
      const target = document.getElementById('dropdown' + field);
      const isVisible = target.style.display === 'block';
      document.querySelectorAll('.custom-dropdown-menu').forEach(d => d.style.display = 'none');
      target.style.display = isVisible ? 'none' : 'block';
    });
  });

  document.querySelectorAll('.option-item-custom[data-field]').forEach(opt => {
    opt.addEventListener('click', function () {
      const field = this.getAttribute('data-field');
      const val = this.getAttribute('data-value');
      document.getElementById('input' + field).value = val;
      document.getElementById('label' + field).textContent = this.textContent.trim();
      markCustomDropdown(field, val);
      document.getElementById('dropdown' + field).style.display = 'none';
    });
  });

  document.querySelectorAll('.dropdown-search-custom').forEach(input => {
    input.addEventListener('input', function() {
      const term = this.value.toLowerCase();
      this.closest('.custom-dropdown-menu').querySelectorAll('.option-item-custom').forEach(item => {
        item.style.display = item.textContent.toLowerCase().includes(term) ? 'block' : 'none';
      });
    });
  });

  const container = document.getElementById('selectedEditionContainer');
  const dropdown = document.getElementById('dropdownContainer');
  const searchInput = document.getElementById('searchEdition');
  const hiddenInput = document.getElementById('edition');
  const placeholder = document.getElementById('editionPlaceholder');
  const options = document.querySelectorAll('.option-item');

  let rawData = <%- JSON.stringify(favoriteEdition || []) %>;
  let selectedEditions = Array.isArray(rawData) ? rawData.filter(v => v && v.trim() !== '') : [];
  const primaryInput = document.getElementById('inputPrimaryTranslation');
  const primaryLabel = document.getElementById('labelPrimaryTranslation');
  const primaryOptions = document.getElementById('primaryTranslationOptions');

  function getAuthorFromValue(val) { return val.includes(':') ? val.split(':')[2] : val; }
  function getIdFromValue(val) { return val.includes(':') ? val.split(':')[0] : val; }
  function getEditionLabel(val) {
    const parts = String(val || '').split(':');
    const lan = parts[1] || '';
    const author = parts[2] || parts[0] || '';
    return lan ? `${lan} - ${author}` : author;
  }

  function syncPrimaryDropdown() {
    if (!primaryInput || !primaryOptions || !primaryLabel) return;
    primaryOptions.innerHTML = '';
    if (selectedEditions.length === 0) {
      primaryInput.value = '';
      primaryLabel.textContent = 'Select editions first';
      return;
    }

    selectedEditions.forEach(val => {
      const opt = document.createElement('div');
      opt.className = 'option-item-custom';
      opt.setAttribute('data-field', 'PrimaryTranslation');
      opt.setAttribute('data-value', val);
      opt.textContent = getEditionLabel(val);
      opt.addEventListener('click', function () {
        primaryInput.value = val;
        primaryLabel.textContent = getEditionLabel(val);
        markCustomDropdown('PrimaryTranslation', val);
        document.getElementById('dropdownPrimaryTranslation').style.display = 'none';
      });
      primaryOptions.appendChild(opt);
    });

    if (!selectedEditions.includes(primaryInput.value)) {
      primaryInput.value = selectedEditions[0];
    }
    primaryLabel.textContent = getEditionLabel(primaryInput.value);
    markCustomDropdown('PrimaryTranslation', primaryInput.value);
  }

  function renderPills() {
    container.querySelectorAll('.edition-pill').forEach(pill => pill.remove());
    if (selectedEditions.length === 0) { placeholder.style.display = 'block'; }
    else {
      placeholder.style.display = 'none';
      selectedEditions.forEach(val => {
        const author = getAuthorFromValue(val);
        const pill = document.createElement('span');
        pill.className = 'edition-pill';
        pill.innerHTML = `${author} <span class="remove-pill" data-value="${val}" style="cursor: pointer; opacity: 0.6;">&times;</span>`;
        container.insertBefore(pill, placeholder);
      });
    }
    hiddenInput.value = JSON.stringify(selectedEditions);
    updateDropdownState();
    syncPrimaryDropdown();
  }

  function updateDropdownState() {
    const selectedIds = selectedEditions.map(val => getIdFromValue(val));
    options.forEach(option => {
      const optionId = option.getAttribute('data-value');
      if (selectedIds.includes(optionId)) {
        option.classList.add('selected-highlight');
        option.style.pointerEvents = "none";
        option.style.opacity = "0.7";
      } else {
        option.classList.remove('selected-highlight');
        option.style.pointerEvents = "auto";
        option.style.opacity = "1";
      }
    });
  }

  container.addEventListener('click', function (e) {
    if (e.target.classList.contains('remove-pill')) {
      selectedEditions = selectedEditions.filter(val => val !== e.target.getAttribute('data-value'));
      renderPills(); return;
    }
    dropdown.style.display = (dropdown.style.display === 'none' || dropdown.style.display === '') ? 'block' : 'none';
  });

  options.forEach(option => {
    option.addEventListener('click', function () {
      const id = this.getAttribute('data-value'), lan = this.getAttribute('data-language'), author = this.getAttribute('data-author');
      if (!selectedEditions.some(item => getIdFromValue(item) === id)) {
        selectedEditions.push(`${id}:${lan}:${author}`);
        renderPills();
      }
      dropdown.style.display = 'none';
    });
  });

  searchInput.addEventListener('input', function (e) {
    const term = e.target.value.toLowerCase();
    document.querySelectorAll('.language-group').forEach(group => {
      let hasVisible = false;
      group.querySelectorAll('.option-item').forEach(opt => {
        const match = (opt.getAttribute('data-author') || '').toLowerCase().includes(term) || (opt.getAttribute('data-language') || '').toLowerCase().includes(term);
        opt.style.display = match ? 'block' : 'none';
        if(match) hasVisible = true;
      });
      group.style.display = hasVisible ? 'block' : 'none';
    });
  });

  document.addEventListener('click', function (e) {
    if (!e.target.closest('.custom-select-wrapper') && !container.contains(e.target) && !dropdown.contains(e.target)) {
      document.querySelectorAll('.custom-dropdown-menu').forEach(d => d.style.display = 'none');
      dropdown.style.display = 'none';
    }
  });

  renderPills();
});
</script>

<%- include('footer') %>
