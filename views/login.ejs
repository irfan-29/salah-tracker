<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= authMode === 'register' ? 'Create account' : 'Sign in' %> · Track My Salah</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-Zenh87qX5JnK2Jl0vWa8Ck2rdkQ2Bzep5IDxbcnCeuOxjzrPF/et3URy9Bv1WTRi" crossorigin="anonymous" />
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" />
</head>
<body class="auth-body">

  <div class="auth-wrap">
    <div class="auth-card">
      <div class="auth-brand">
        <span class="auth-logo material-symbols-rounded">mosque</span>
        <h1 class="auth-title">Salah Tracker</h1>
        <p class="auth-sub"><%= authMode === 'register' ? 'Create your account' : 'Welcome back' %></p>
      </div>

      <% if (authError) { %>
        <div class="auth-alert" role="alert">
          <span class="material-symbols-rounded">error</span>
          <%= authError %>
        </div>
      <% } %>

      <form action="<%= authMode === 'register' ? '/register' : '/login' %>" method="POST" class="auth-form">
        <div class="form-floating">
          <input class="form-control" type="email" id="email" name="email" required
                 autocomplete="email" placeholder="you@example.com" value="<%= authEmail %>">
          <label for="email">Email address</label>
        </div>

        <div class="form-floating">
          <input class="form-control" type="password" id="password" name="password" required minlength="6"
                 autocomplete="<%= authMode === 'register' ? 'new-password' : 'current-password' %>" placeholder="••••••••">
          <label for="password">Password</label>
        </div>

        <% if (authMode === 'register') { %>
        <div class="form-floating">
          <input class="form-control" type="password" id="cpassword" name="cpassword" required minlength="6"
                 autocomplete="new-password" placeholder="••••••••">
          <label for="cpassword">Confirm password</label>
        </div>
        <p class="auth-hint">At least 6 characters.</p>
        <% } %>

        <button type="submit" class="btn btn-primary auth-submit">
          <%= authMode === 'register' ? 'Create account' : 'Sign in' %>
        </button>
      </form>

      <% if (authMode === 'register') { %>
        <p class="auth-switch">Already have an account? <a href="/login">Sign in</a></p>
      <% } else { %>
        <p class="auth-switch">New here? <a href="/register">Create an account</a></p>
      <% } %>

      <div class="auth-divider"><span>or</span></div>
      <a href="/quran" class="auth-guest">Continue without an account</a>
      <p class="auth-note">
        Your progress is kept in this browser and carried over the moment you sign in.
      </p>
    </div>
  </div>

</body>
</html>
