<%- include("navbar") -%>

<div class="page-header">
  <h1>Islamic Calendar</h1>
  <p>Hijri &amp; Gregorian dates with special Islamic days</p>
</div>

<div class="container1 calendar-wrapper">
  <div class="calendar-header">
    <div class="gregorian-title"><%= gregorianMonth %> <%= gregorianYear %></div>
    <div class="hijri-title"><%= hijriMonthName %> <%= hijriYear %> AH</div>
  </div>

  <form action="/calendar" method="get" class="calendar-controls">
    <button type="submit" name="month" value="<%= hijriMonth === 1 ? 12 : hijriMonth - 1 %>" class="btn-ghost btn-icon" aria-label="Previous month">
      <span class="material-symbols-rounded">chevron_left</span>
    </button>
    <select name="month">
      <% for (let i = 1; i <= 12; i++) { %>
        <option value="<%= i %>" <%= i === hijriMonth ? 'selected' : '' %>><%= i %></option>
      <% } %>
    </select>
    <input type="number" name="year" value="<%= hijriYear %>">
    <button type="submit" class="btn btn-primary btn-sm">Go</button>
    <button type="submit" name="month" value="<%= hijriMonth === 12 ? 1 : hijriMonth + 1 %>" class="btn-ghost btn-icon" aria-label="Next month">
      <span class="material-symbols-rounded">chevron_right</span>
    </button>
  </form>

  <table class="calendar-table">
    <thead>
      <tr>
        <th>Sun</th><th>Mon</th><th>Tue</th><th>Wed</th>
        <th>Thu</th><th>Fri</th><th>Sat</th>
      </tr>
    </thead>
    <tbody>
      <% weeks.forEach(week => { %>
        <tr>
          <% week.forEach(day => { %>
            <% if (day) { %>
              <td>
                <div class="date-box">
                  <div class="greg"><%= day.gregorian %></div>
                  <div class="hijri"><%= day.hijri %></div>
                </div>
              </td>
            <% } else { %>
              <td style="background: transparent; border: none; box-shadow: none;"></td>
            <% } %>
          <% }) %>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<div class="page-header" style="margin-top: 2rem;">
  <h1>Special Islamic Days</h1>
  <p>Upcoming events and observances</p>
</div>

<div class="container1">
  <table class="table table-striped">
    <thead>
      <tr>
        <th>Date</th>
        <th>Event</th>
        <th>Hijri Date</th>
      </tr>
    </thead>
    <tbody>
      <% specialDays.forEach(function(day) { %>
        <tr>
          <td>
            <%= day.date %><br>
            <span class="badge badge-info"><%= day.weekday %></span>
          </td>
          <td><strong><%= day.event %></strong></td>
          <td><em><%= day.hijriDate %><br><%= day.hijriYear %></em></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<%- include('footer') %>
