<%- include("navbar") -%>

<div class="page-header">
  <h1>Post</h1>
  <p>
    <%# author is a populate() and can be null if the account was deleted, so
        this must not assume it resolved. %>
    <% if (post.author && post.author.username) { %>
      <a class="post-author" href="/u/<%= post.author.username %>"><span class="post-author-at">@</span><%= post.author.username %></a>
    <% } else if (post.authorName) { %>
      by <span class="post-author-anonymous"><%= post.authorName %></span>
    <% } %>
  </p>
</div>

<%- include("post-card", { post, permalinkBase }) %>

<p class="post-back"><a href="/posts">&larr; Back to all posts</a></p>

<%- include('footer') %>