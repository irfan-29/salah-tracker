<%- include("navbar") -%>

<div class="page-header">
  <h1>Posts</h1>
  <p>Reflections, reminders, and videos</p>
</div>

<div class="post-actions">
  <form action="/add-post" method="get">
    <button type="submit" class="btn btn-primary">
      <span class="material-symbols-rounded" style="font-size: 1.1rem;">edit_note</span>
      Add Post
    </button>
  </form>
  <form action="/add-video" method="get">
    <button type="submit" class="btn btn-outline-primary">
      <span class="material-symbols-rounded" style="font-size: 1.1rem;">videocam</span>
      Add Video
    </button>
  </form>
</div>

<% post.forEach(function(post) { %>
  <% if(post.isVideo) { %>
    <div class="post-card post-card-video">
      <div class="post-video-embed">
        <iframe src="https://www.youtube.com/embed/<%= post.content %>" allowfullscreen></iframe>
      </div>
      <div class="post-card-body">
        <p class="post-reference"><%= post.reference %></p>
        <p class="post-date"><%= post.postedDate %></p>
      </div>
    </div>
  <% } else { %>
    <div class="post-card">
      <p class="post-content"><%= post.content %></p>
      <p class="post-reference">Reference: <%= post.reference %></p>
      <p class="post-date"><%= post.postedDate %></p>
    </div>
  <% } %>
<% }); %>

<div class="post-card post-card-shorts">
  <div class="post-shorts-embed">
    <iframe src="https://youtube.com/embed/MMT9lvEW1HM" allowfullscreen></iframe>
  </div>
  <div class="post-card-body">
    <p class="post-reference">FurQan</p>
    <p class="post-date">Feb 16, 2026</p>
  </div>
</div>

<%- include('footer') %>
