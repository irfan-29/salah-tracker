<%- include("navbar") -%>

<div class="page-header">
  <h1>Posts</h1>
  <p>Reflections, reminders, and videos</p>
</div>

<div class="post-actions">
  <form action="/add-post" method="get">
    <button type="submit" class="btn btn-primary">
      <span class="material-symbols-rounded" style="font-size: 1.1rem;">edit_note</span>
      Add Post
    </button>
  </form>
  <form action="/add-video" method="get">
    <button type="submit" class="btn btn-outline-primary">
      <span class="material-symbols-rounded" style="font-size: 1.1rem;">videocam</span>
      Add Video
    </button>
  </form>
</div>

<% if (!post.length) { %>
  <p class="post-empty">No posts yet.</p>
<% } %>

<% post.forEach(function(p) { %>
  <%- include("post-card", { post: p, permalinkBase }) %>
<% }); %>

<%# Seed content that predates per-user posts - kept so the feed is not empty on
    a fresh database. Not part of anyone's profile. %>
<div class="post-card post-card-video post-card-shorts">
  <div class="post-card-head">
    <span class="post-author post-author-anonymous">FurQan</span>
  </div>
  <div class="post-shorts-embed">
    <iframe src="https://youtube.com/embed/MMT9lvEW1HM" allowfullscreen></iframe>
  </div>
  <div class="post-card-body">
    <p class="post-reference">FurQan</p>
    <p class="post-date">Feb 16, 2026</p>
  </div>
</div>

<%- include('footer') %>