<%- include("navbar") -%>

<div class="page-header">
  <h1>Challenges</h1>
  <p>Build habits and track your streaks</p>
</div>

<div class="post-actions">
  <a href="/add-challenge" class="btn btn-primary">Add new challenge</a>
</div>

<div class="container1">
  <form id="streakForm" action="/update-streaks" method="POST">
    <div class="form-floating">
      <input class="form-control" type="date" required id="date" name="date">
      <label for="date">Date</label>
    </div>
  </form>

  <div class="challenge-list" style="margin-top: 1.25rem;">
    <% if (!keyChallenge || keyChallenge.length === 0) { %>
      <p class="challenge-empty">No challenges yet. Add one to start a streak.</p>
    <% } %>
    <% keyChallenge.forEach(function(challenge, i) { %>
      <div class="challenge-card" data-challenge-id="<%= challenge._id %>">
        <input form="streakForm" type="checkbox" name="completed[]" value="<%= challenge._id %>" id="challenge_<%= i %>">
        <div class="challenge-info">
          <div class="challenge-header-row">
            <label for="challenge_<%= i %>" class="challenge-title-label"><strong><%= challenge.challenge %></strong></label>
            <div class="challenge-actions">
              <a href="/edit-challenge/<%= challenge._id %>" class="challenge-icon-btn challenge-icon-btn-edit" aria-label="Edit challenge" title="Edit">
                <span class="material-symbols-rounded" aria-hidden="true">edit</span>
              </a>
              <form action="/delete-challenge" method="POST" onsubmit="return confirm('Delete this challenge?');">
                <input type="hidden" name="id" value="<%= challenge._id %>">
                <button type="submit" class="challenge-icon-btn challenge-icon-btn-danger" aria-label="Delete challenge" title="Delete">
                  <span class="material-symbols-rounded" aria-hidden="true">delete</span>
                </button>
              </form>
            </div>
          </div>
          <div style="margin-top: 0.5rem;">
            <span class="streak-badge">🔥 <%= challenge.currentStreak || 0 %> day streak</span>
            <span class="badge badge-accent">Best: <%= challenge.maxStreak || 0 %></span>
          </div>
          <p class="challenge-meta">Last updated: <%= challenge.lastUpdated || '—' %></p>
        </div>
      </div>
    <% }); %>
  </div>

  <% if (keyChallenge && keyChallenge.length > 0) { %>
  <div class="new-task" style="margin-top: 1.5rem;">
    <button form="streakForm" type="submit" class="btn btn-success">Update Streaks</button>
  </div>
  <% } %>
</div>

<%- include('footer') %>
