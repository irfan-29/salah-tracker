<%- include("navbar") -%>

<div class="page-header">
  <h1>Challenges</h1>
  <p>Build habits and track your streaks</p>
</div>

<div class="container1">
  <form action="/update-streaks" method="POST">
    <div class="form-floating">
      <input class="form-control" type="date" required id="date" name="date">
      <label for="date">Date</label>
    </div>

    <div class="challenge-list">
      <% keyChallenge.forEach(function(challenge, i) { %>
        <div class="challenge-card">
          <input type="checkbox" name="completed[]" value="<%= challenge._id %>" id="challenge_<%= i %>">
          <div class="challenge-info">
            <label for="challenge_<%= i %>"><strong><%= challenge.challenge %></strong></label>
            <div style="margin-top: 0.5rem;">
              <span class="streak-badge">🔥 <%= challenge.currentStreak %> day streak</span>
              <span class="badge badge-accent">Best: <%= challenge.maxStreak %></span>
            </div>
            <p class="challenge-meta">Last updated: <%= challenge.lastUpdated %></p>
          </div>
        </div>
      <% }); %>
    </div>

    <div class="new-task" style="margin-top: 1.5rem;">
      <button type="submit" class="btn btn-success">Update Streaks</button>
    </div>
  </form>
</div>

<%- include('footer') %>
