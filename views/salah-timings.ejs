<%- include("navbar") -%>

<div class="page-header">
  <h1>Salah Timings</h1>
  <p>Prayer times for <%= keyPrayerDetails.location %></p>
</div>

<div class="prayer-meta">
  <h2><%= keyPrayerDetails.date %></h2>
  <p><%= keyPrayerDetails.hijriDate %></p>
</div>

<div class="prayer-grid">
  <% keyPrayerDetails.prayerTimes.forEach(function(prayer) { %>
    <div class="prayer-card">
      <div class="prayer-name"><%= prayer.timeType %></div>
      <div class="prayer-time"><%= prayer.time %></div>
    </div>
  <% }); %>
</div>

<div class="container1">
  <div class="card-header">
    <h3>Change Location</h3>
  </div>
  <form action="/location" method="post">
    <input type="hidden" name="redirectTo" value="/salah-timings">
    <div class="form-row">
      <div class="form-floating">
        <select name="location" id="location" required class="form-control">
          <option value="Coimbatore" <%= "Coimbatore" === location ? 'selected' : '' %>>Coimbatore</option>
          <option value="Hosur" <%= "Hosur" === location ? 'selected' : '' %>>Hosur</option>
          <option value="Salem" <%= "Salem" === location ? 'selected' : '' %>>Salem</option>
          <option value="Ramanathapuram" <%= "Ramanathapuram" === location ? 'selected' : '' %>>Ramanathapuram</option>
          <option value="Bengaluru" <%= "Bengaluru" === location ? 'selected' : '' %>>Bengaluru</option>
        </select>
        <label for="location">Location</label>
      </div>
      <button type="submit" class="btn btn-primary" value="add" name="add">Update</button>
    </div>
  </form>
</div>

<%- include('footer') %>
