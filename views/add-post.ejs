<%- include("navbar") -%>

<div class="page-header">
  <h1>Add Post</h1>
  <p>Share a reflection or reminder</p>
</div>

<div class="container1">
  <form action="/add-post" method="POST">
    <div class="form-floating">
      <input class="form-control" type="text" required placeholder="content" id="content" name="content">
      <label for="content">Content</label>
    </div>
    <div class="form-floating">
      <input class="form-control" type="text" placeholder="reference" id="reference" name="reference">
      <label for="reference">Reference (optional)</label>
    </div>
    <div class="new-task">
      <button type="submit" class="btn btn-primary" value="add" name="add">Publish Post</button>
    </div>
  </form>
</div>

<%- include('footer') %>
