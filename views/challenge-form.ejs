<%- include("navbar") -%>

<% const isEdit = mode === "edit" && challenge; %>

<div class="page-header">
  <h1><%= isEdit ? 'Edit Challenge' : 'Add Challenge' %></h1>
  <p><%= isEdit ? 'Update the name of this challenge' : 'Start a new habit and track your streak' %></p>
</div>

<div class="container1">
  <form action="<%= isEdit ? '/edit-challenge' : '/add-challenge' %>" method="POST">
    <% if (isEdit) { %>
      <input type="hidden" name="id" value="<%= challenge._id %>">
    <% } %>
    <div class="form-floating">
      <input class="form-control" type="text" required id="challenge" name="challenge" placeholder="Enter your challenge" value="<%= isEdit ? challenge.challenge : '' %>">
      <label for="challenge">e.g., Drink 4L of water daily</label>
    </div>
    <div class="new-task" style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
      <button type="submit" class="btn btn-primary"><%= isEdit ? 'Save Challenge' : 'Add Challenge' %></button>
      <a href="/challenges" class="btn btn-outline">Cancel</a>
    </div>
  </form>
</div>

<%- include('footer') %>
