
  </main>

  <%# Rendered when a track is already saved, OR on any Quran page so the
      Audio tab has a player to hand a surah to even with nothing in progress.
      The track fields are filled by JS rather than EJS so window.quranAudio.play()
      can retarget the bar without a reload. %>
  <% const audioTrack = (typeof footerAudio !== 'undefined' && footerAudio) ? footerAudio : null; %>
  <% const showAudioBar = Boolean(audioTrack) || (typeof audioShell !== 'undefined' && audioShell); %>
  <% if (showAudioBar) { %>
  <div class="global-audio-bar<%= audioTrack ? '' : ' is-idle' %>" id="globalAudioBar"<%= audioTrack ? '' : ' hidden' %>>
    <div class="audio-bar-inner">
      <div class="audio-bar-track-info">
        <div class="audio-artwork" id="audioArtwork">
          <img src="/images/audio-player.webp" id="audioIcon" alt="Quran Audio" class="rotating-icon" />
        </div>
        <div class="audio-track-meta">
          <div class="surah-title" id="audioSurahTitle"><%= audioTrack ? audioTrack.surahNo + '. ' + audioTrack.surahName : '' %></div>
          <div class="reciter-name" id="audioReciterName"><%= audioTrack ? audioTrack.reciterName : '' %></div>
        </div>
      </div>

      <div class="audio-bar-center">
        <div class="audio-transport">
          <button type="button" class="audio-btn" id="audioPrevBtn" aria-label="Previous surah">
            <span class="material-symbols-rounded">skip_previous</span>
          </button>
          <button type="button" class="audio-btn audio-btn-play" id="audioPlayBtn" aria-label="Play/Pause">
            <span class="material-symbols-rounded" id="playIcon">play_arrow</span>
          </button>
          <button type="button" class="audio-btn" id="audioNextBtn" aria-label="Next surah">
            <span class="material-symbols-rounded">skip_next</span>
          </button>
        </div>
        <div class="audio-progress-row">
          <span class="audio-time" id="audioCurrentTime">0:00</span>
          <div class="audio-progress-track" id="progressTrack">
            <div class="audio-progress-fill" id="progressFill"></div>
            <input type="range" class="audio-progress-input" id="progressInput" min="0" max="100" value="0" aria-label="Seek">
          </div>
          <span class="audio-time" id="audioDuration">0:00</span>
        </div>
      </div>

      <form action="/hide-audio" method="POST" class="audio-close-form">
        <button type="submit" class="audio-close-btn" aria-label="Close audio">
          <span class="material-symbols-rounded">close</span>
        </button>
      </form>
    </div>

    <%# src is assigned by script rather than markup: window.quranAudio.play()
        swaps the track, and a <source> child would otherwise keep offering the
        original URL after the element's src changed. %>
    <audio id="globalAudio" preload="metadata"
      <%= audioTrack ? 'src="' + audioTrack.url + '"' : '' %>></audio>
    <script id="quranAudioConfig" type="application/json">
    <%- JSON.stringify({
          track: audioTrack ? { url: audioTrack.url, surahNo: audioTrack.surahNo, surahName: audioTrack.surahName, reciterName: audioTrack.reciterName, startAt: audioTrack.time || 0 } : null
        }) %>
    </script>
  </div>

  <%# Share buttons: copy the permalink, or hand it to the OS share sheet.
      Delegated on document because the buttons are rendered inside page
      content, not in a stable container of their own. %>
  <script>
    (function () {
      const RESET_MS = 1600;

      function flashCopied(button) {
        const label = button.querySelector('.post-share-label');
        button.dataset.copied = 'true';
        if (label) label.textContent = 'Link copied';
        setTimeout(function () {
          delete button.dataset.copied;
          if (label) label.textContent = 'Share';
        }, RESET_MS);
      }

      async function share(button) {
        const url = button.dataset.shareUrl;
        if (!url) return;

        // navigator.share is the better experience where it exists, but it is
        // absent on desktop Chrome and on any non-secure origin, so the
        // clipboard has to be the real path rather than the fallback.
        if (navigator.share) {
          try {
            await navigator.share({ title: document.title, url: url });
            return;
          } catch (err) {
            if (err && err.name === 'AbortError') return;
            // Fall through to copying.
          }
        }

        try {
          await navigator.clipboard.writeText(url);
          flashCopied(button);
        } catch (err) {
          // Clipboard API needs a secure context. Select the text instead of
          // silently doing nothing.
          const field = document.createElement('textarea');
          field.value = url;
          field.setAttribute('readonly', '');
          field.style.position = 'absolute';
          field.style.left = '-9999px';
          document.body.appendChild(field);
          field.select();
          try { document.execCommand('copy'); flashCopied(button); } catch (e) {}
          document.body.removeChild(field);
        }
      }

      document.addEventListener('click', function (event) {
        const button = event.target.closest('[data-share-url]');
        if (button) share(button);
      });
    })();
  </script>

<script>
    (function () {
      const audio = document.getElementById('globalAudio');
      const bar = document.getElementById('globalAudioBar');
      if (!audio || !bar) return;

      const playBtn = document.getElementById('audioPlayBtn');
      const playIcon = document.getElementById('playIcon');
      const prevBtn = document.getElementById('audioPrevBtn');
      const nextBtn = document.getElementById('audioNextBtn');
      const progressFill = document.getElementById('progressFill');
      const progressInput = document.getElementById('progressInput');
      const currentTimeEl = document.getElementById('audioCurrentTime');
      const durationEl = document.getElementById('audioDuration');
      const titleEl = document.getElementById('audioSurahTitle');
      const reciterEl = document.getElementById('audioReciterName');

      const configEl = document.getElementById('quranAudioConfig');
      let config = { track: null };
      if (configEl) {
        try { config = JSON.parse(configEl.textContent) || { track: null }; } catch (e) {}
      }

      let track = config.track || null;
      // Surah numbers, for the prev/next transport. Kept in sync with the
      // current track rather than fetched, so seeking between neighbours does
      // not wait on a round trip.
      let currentSurahNo = track ? Number(track.surahNo) : 1;
      let lastSavedTime = 0;
      let navNames = {};

      function formatTime(seconds) {
        if (!isFinite(seconds) || seconds < 0) return '0:00';
        const m = Math.floor(seconds / 60);
        const s = Math.floor(seconds % 60);
        return m + ':' + String(s).padStart(2, '0');
      }

      function renderTrack() {
        if (!track) return;
        if (titleEl) titleEl.textContent = currentSurahNo + '. ' + (track.surahName || '');
        if (reciterEl) reciterEl.textContent = track.reciterName || '';
      }

      function setPlayIcon(playing) {
        if (playIcon) playIcon.textContent = playing ? 'pause' : 'play_arrow';
        if (playBtn) playBtn.setAttribute('aria-label', playing ? 'Pause' : 'Play');
      }

      // --- Saving position ------------------------------------------------
      // Persisted on a throttle while playing AND unconditionally on pause and
      // on page hide. The old version only saved every 5s while playing, so
      // closing the tab mid-recitation lost up to five seconds, and pausing to
      // read the translation saved nothing at all.
      function savePosition(force) {
        if (!track) return;
        if (!force && Math.abs(audio.currentTime - lastSavedTime) < 5) return;
        if (isNaN(audio.currentTime)) return;
        lastSavedTime = audio.currentTime;

        const payload = JSON.stringify({
          surahNo: currentSurahNo,
          surahName: (track && track.surahName) || '',
          time: audio.currentTime
        });

        // sendBeacon on unload: a normal fetch is cancelled mid-navigation,
        // which is exactly when the save matters most.
        if (force && navigator.sendBeacon) {
          navigator.sendBeacon('/update-audio-time', new Blob([payload], { type: 'application/json' }));
          return;
        }
        fetch('/update-audio-time', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: payload,
          keepalive: true
        }).catch(() => {});
      }

      // --- Public API -----------------------------------------------------
      // The Audio tab calls this instead of creating its own <audio>, so there
      // is exactly one element on the page and switching tabs cannot interrupt
      // playback.
      window.quranAudio = {
        play: function (next) {
          if (!next || !next.url) return;
          const wasDifferent = !track || track.url !== next.url;

          track = {
            url: next.url,
            surahName: next.surahName,
            reciterName: next.reciterName
          };
          currentSurahNo = Number(next.surahNo) || currentSurahNo;

          audio.src = next.url;
          audio.load();
          renderTrack();
          bar.classList.remove('is-idle');
          bar.hidden = false;

          const startAt = Number(next.startAt) || 0;
          const resume = () => {
            if (startAt > 0) audio.currentTime = startAt;
            // Autoplay can be refused when play() follows a network round trip
            // instead of a user gesture. That is expected; the bar is visible
            // and the user presses play.
            audio.play().catch(() => setPlayIcon(false));
          };
          if (audio.readyState >= 1) resume();
          else audio.addEventListener('loadedmetadata', resume, { once: true });

          lastSavedTime = wasDifferent ? 0 : lastSavedTime;
        },
        show: function () {
          bar.classList.remove('is-idle');
          bar.hidden = false;
        },
        hide: function () {
          bar.hidden = true;
        },
        close: function () {
          audio.pause();
          track = null;
          bar.classList.add('is-idle');
          bar.hidden = true;
        },
        isPlaying: function () { return !audio.paused && !audio.ended; },
        current: function () { return track ? { surahNo: currentSurahNo, surahName: track.surahName } : null; }
      };

      // --- Wiring ---------------------------------------------------------
      if (playBtn) {
        playBtn.addEventListener('click', function () {
          if (!track) return;
          if (audio.paused) audio.play().catch(() => {});
          else audio.pause();
        });
      }

      // Surah names for the prev/next labels, taken from the Read tab markup
      // when it is on the same page. Falls back to the bare number elsewhere.
      function surahNameFor(no) {
        return navNames[no] || ('Surah ' + no);
      }

      function step(delta) {
        const target = currentSurahNo + delta;
        if (target < 1 || target > 114) return;
        const url = audio.src || '';
        // mp3quran encodes the surah number zero-padded to three digits; using
        // the same shape keeps the next/prev buttons working for the default
        // reciter without another lookup.
        const match = url.match(/\/(\d{3})\.mp3/);
        if (!match) {
          currentSurahNo = target;
          savePosition(true);
          return;
        }
        const nextUrl = url.replace(/\/\d{3}\.mp3/, '/' + String(target).padStart(3, '0') + '.mp3');
        window.quranAudio.play({
          url: nextUrl,
          surahNo: target,
          surahName: surahNameFor(target),
          reciterName: track ? track.reciterName : '',
          startAt: 0
        });
      }

      if (prevBtn) prevBtn.addEventListener('click', () => step(-1));
      if (nextBtn) nextBtn.addEventListener('click', () => step(1));

      audio.addEventListener('play', () => setPlayIcon(true));
      audio.addEventListener('pause', () => {
        setPlayIcon(false);
        savePosition(true);
      });
      audio.addEventListener('ended', () => {
        setPlayIcon(false);
        savePosition(true);
        // Roll on to the next surah rather than leaving a finished bar.
        if (currentSurahNo < 114) step(1);
      });

      audio.addEventListener('timeupdate', function () {
        const d = audio.duration;
        const t = audio.currentTime;
        if (isFinite(d) && d > 0) {
          const pct = (t / d) * 100;
          if (progressFill) progressFill.style.width = pct + '%';
          if (progressInput) progressInput.value = String(pct);
        }
        if (currentTimeEl) currentTimeEl.textContent = formatTime(t);
        savePosition(false);
      });

      audio.addEventListener('loadedmetadata', function () {
        if (durationEl) durationEl.textContent = formatTime(audio.duration);
      });

      if (progressInput) {
        progressInput.addEventListener('input', function () {
          const d = audio.duration;
          if (isFinite(d) && d > 0) audio.currentTime = (Number(progressInput.value) / 100) * d;
        });
      }

      // Leaving the page mid-ayah is the case the old implementation lost.
      window.addEventListener('pagehide', function () { savePosition(true); });
      document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'hidden') savePosition(true);
      });

      // Restore the saved position on load, but stay paused. Browsers block
      // autoplay without a gesture, and silently starting recitation the moment
      // a page loads would be worse than making the user press play.
      if (track) {
        renderTrack();
        bar.classList.remove('is-idle');
        bar.hidden = false;
        const resumeAt = Number(track.startAt) || 0;
        if (resumeAt > 0) {
          const apply = () => {
            try { audio.currentTime = resumeAt; } catch (e) {}
          };
          if (audio.readyState >= 1) apply();
          else audio.addEventListener('loadedmetadata', apply, { once: true });
        }
        setPlayIcon(false);
      }

      // Picking up names from the Read tab keeps prev/next labels readable
      // without shipping the whole surah index to every page.
      const surahOptions = document.getElementById('surahOptions');
      if (surahOptions) {
        surahOptions.querySelectorAll('[data-surahid]').forEach(function (option) {
          navNames[Number(option.dataset.surahid)] = option.textContent.trim();
        });
      }

      // The close button is a form post that also clears the saved position.
      const closeForm = document.querySelector('.audio-close-form');
      if (closeForm) {
        closeForm.addEventListener('submit', function () {
          track = null;
          bar.classList.add('is-idle');
        });
      }
    })();
  </script>
  <% } %>

</body>
</html>
