<%- include("navbar") -%>

<div class="page-header">
  <h1>Quran</h1>
  <p>Read, listen, and reflect on the Holy Quran</p>
</div>

<div class="container1">
  <div class="featured-label">Ayah of the Day</div>
  <a href="/surah/3">
    <div class="featured-surah">
      <p class="surah-name">3. <%= surahs[2].surahName %> ( <%= surahs[2].surahNameArabic %> )</p>
      <p class="surah-translation"><%= surahs[2].surahNameTranslation %></p>
      <p class="surah-meta">Revelation: <%= surahs[2].revelationPlace %> · <%= surahs[2].totalAyah %> Ayahs</p>
    </div>
  </a>
</div>

<% if (lastReadSurahs && lastReadSurahs.length > 0) { %>
<div class="container1">
  <div class="card-header">
    <h3>Continue Reading</h3>
  </div>
  <div class="scrollable-container">
    <% lastReadSurahs.forEach(function(surahNo) { %>
      <a href="/surah/<%= surahNo %>" class="surah-pill">
        <%= surahNo %>. <%= surahs[surahNo - 1].surahName %>
      </a>
    <% }) %>
  </div>
</div>
<% } %>

<div class="container1">
  <div class="card-header">
    <h3>Find a Surah</h3>
  </div>
  <div class="surah-search-wrapper">
    <input type="text" id="selectedSurah" class="surah-search-input" placeholder="Search by number or name" readonly required>
    <div id="surahDropdownContainer" class="surah-dropdown">
      <input type="text" id="searchSurah" class="dropdown-search-custom" placeholder="Search Surah Number or Name...">
      <div id="surahOptions">
        <% surahs.forEach(function(surah, index) { %>
          <div class="surah-option"
            data-surahid="<%= index + 1 %>"
            data-name="<%= surah.surahName %>">
            <%= index + 1 %>. <%= surah.surahName %>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
</div>

<div class="container1">
  <div class="card-header">
    <h3>All Surahs</h3>
    <span class="badge badge-primary">114 Surahs</span>
  </div>
  <div class="surah-grid">
    <% for (let i = 0; i < surahs.length; i++) {
      const surah = surahs[i]; %>
      <a href="/surah/<%= i + 1 %>" class="surah-card">
        <span class="surah-card-number"><%= i + 1 %></span>
        <div class="surah-card-content">
          <p class="surah-name"><%= surah.surahName %></p>
          <p class="surah-arabic"><%= surah.surahNameArabic %></p>
          <p class="surah-translation"><%= surah.surahNameTranslation %></p>
          <p class="surah-meta"><%= surah.revelationPlace %> · <%= surah.totalAyah %> Ayahs</p>
        </div>
        <span class="material-symbols-rounded surah-card-arrow">chevron_right</span>
      </a>
    <% } %>
  </div>
</div>

<button onclick="topFunction()" id="myBtn" title="Go to Top" aria-label="Scroll to top">
  <span class="material-symbols-rounded">keyboard_arrow_up</span>
</button>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const selectedInput = document.getElementById('selectedSurah');
    const dropdown = document.getElementById('surahDropdownContainer');
    const searchInput = document.getElementById('searchSurah');
    const optionsContainer = document.getElementById('surahOptions');

    selectedInput.addEventListener('click', function() {
      dropdown.style.display = dropdown.style.display === 'block' ? 'none' : 'block';
      if (dropdown.style.display === 'block') searchInput.focus();
    });

    optionsContainer.addEventListener('click', function(e) {
      const option = e.target.closest('.surah-option');
      if (option) {
        window.location.href = "/surah/" + option.getAttribute('data-surahid');
      }
    });

    searchInput.addEventListener('input', function() {
      const term = this.value.trim().toLowerCase();
      optionsContainer.querySelectorAll('.surah-option').forEach(function(option) {
        const name = option.getAttribute('data-name').toLowerCase();
        const num = option.getAttribute('data-surahid').toLowerCase();
        option.style.display = (name.includes(term) || num.includes(term)) ? 'block' : 'none';
      });
    });

    document.addEventListener('click', function(e) {
      if (!dropdown.contains(e.target) && e.target !== selectedInput) {
        dropdown.style.display = 'none';
      }
    });
  });

  const mybutton = document.getElementById("myBtn");
  window.onscroll = function() {
    mybutton.style.display = (document.documentElement.scrollTop > 20) ? "flex" : "none";
  };
  function topFunction() {
    document.documentElement.scrollTop = 0;
  }
</script>

<%- include('footer') %>
