<%# Audio tab. The reciter lives here only - it used to be a per-surah dropdown
    on the reading page, which meant the reader and the player could disagree
    about who was speaking. One reciter for the module now. %>
<div class="quran-tab-panel" data-tab-panel="audio" hidden>
  <div class="container1">
    <div class="card-header">
      <h3>Reciter</h3>
    </div>

    <% if (!reciters.length) { %>
      <p class="post-empty">Could not load the reciter list. Please try again shortly.</p>
    <% } else { %>
      <div class="reciter-row">
        <label class="sr-only" for="reciterSelect">Choose a reciter</label>
        <select id="reciterSelect" class="form-control">
          <% reciters.forEach(function(r) { %>
            <option value="<%= r.id %>" <%= r.id === activeReciter ? 'selected' : '' %>><%= r.name %></option>
          <% }); %>
        </select>
        <button type="button" class="btn btn-primary" id="saveReciterBtn">
          <span class="material-symbols-rounded">save</span>
          Save
        </button>
      </div>
      <p class="tg-hint" id="reciterStatus"></p>
    <% } %>
  </div>

  <div class="container1">
    <div class="card-header">
      <h3>Play</h3>
      <span class="badge badge-primary">114 Surahs</span>
    </div>

    <div class="surah-search-wrapper">
      <input type="text" id="audioSearch" class="surah-search-input" placeholder="Search surah to play" readonly>
      <div id="audioDropdownContainer" class="surah-dropdown">
        <input type="text" id="audioSearchInput" class="dropdown-search-custom" placeholder="Search Surah Number or Name...">
        <div id="audioOptions">
          <% surahs.forEach(function(surah, index) { %>
            <button type="button" class="surah-option audio-surah-option"
              data-surahid="<%= index + 1 %>"
              data-name="<%= surah.surahName %>">
              <span><%= index + 1 %>. <%= surah.surahName %></span>
              <span class="material-symbols-rounded audio-option-icon">play_circle</span>
            </button>
          <% }); %>
        </div>
      </div>
    </div>
  </div>
</div>