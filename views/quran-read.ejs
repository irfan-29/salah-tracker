<%# Read tab: ayah of the day, continue reading, and the surah index.
    Switched client-side, so nothing here should depend on a page load. %>
<div class="quran-tab-panel" data-tab-panel="read">
  <div class="container1">
    <div class="featured-label">Ayah of the Day</div>
    <a href="/surah/<%= ayahOfTheDay.surahNo %>?ayah=<%= ayahOfTheDay.ayahNo %>">
      <div class="featured-surah">
        <div class="featured-ayah-ref">
          <p class="featured-ayah-cite">Surah <%= ayahOfTheDay.surahNo %> · Ayah <%= ayahOfTheDay.ayahNo %></p>
          <p class="featured-ayah-surah">
            <%= ayahOfTheDay.surahName %>
            <% if (ayahOfTheDay.surahNameArabic) { %> · <%= ayahOfTheDay.surahNameArabic %><% } %>
          </p>
        </div>
        <% if (ayahOfTheDay.arabicText) { %>
          <p class="featured-ayah-arabic" style="font-family: '<%= favoriteFont %>', serif;"><%= ayahOfTheDay.arabicText %></p>
        <% } %>
        <% if (ayahOfTheDay.translationText) { %>
          <% if (ayahOfTheDay.translationLabel) { %>
            <p class="featured-ayah-edition"><%= ayahOfTheDay.translationLabel %></p>
          <% } %>
          <p class="featured-ayah-translation"><%= ayahOfTheDay.translationText %></p>
        <% } %>
      </div>
    </a>
  </div>

  <% if (lastReadSurahs && lastReadSurahs.length > 0) { %>
  <div class="container1">
    <div class="card-header">
      <h3>Continue Reading</h3>
    </div>
    <div class="scrollable-container">
      <% lastReadSurahs.forEach(function(surahNo) { %>
        <a href="/surah/<%= surahNo %>" class="surah-pill">
          <%= surahNo %>. <%= surahs[surahNo - 1].surahName %>
        </a>
      <% }) %>
    </div>
  </div>
  <% } %>

  <div class="container1">
    <div class="card-header">
      <h3>Find a Surah</h3>
    </div>
    <div class="surah-search-wrapper">
      <input type="text" id="selectedSurah" class="surah-search-input" placeholder="Search by number or name" readonly>
      <div id="surahDropdownContainer" class="surah-dropdown">
        <input type="text" id="searchSurah" class="dropdown-search-custom" placeholder="Search Surah Number or Name...">
        <div id="surahOptions">
          <% surahs.forEach(function(surah, index) { %>
            <div class="surah-option"
              data-surahid="<%= index + 1 %>"
              data-name="<%= surah.surahName %>">
              <%= index + 1 %>. <%= surah.surahName %>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
  </div>

  <div class="container1">
    <div class="card-header">
      <h3>All Surahs</h3>
      <span class="badge badge-primary">114 Surahs</span>
    </div>
    <div class="surah-grid">
      <% for (let i = 0; i < surahs.length; i++) {
        const surah = surahs[i]; %>
        <a href="/surah/<%= i + 1 %>" class="surah-card">
          <span class="surah-card-number"><%= i + 1 %></span>
          <div class="surah-card-content">
            <p class="surah-name"><%= surah.surahName %></p>
            <p class="surah-arabic"><%= surah.surahNameArabic %></p>
            <p class="surah-translation"><%= surah.surahNameTranslation %></p>
            <p class="surah-meta"><%= surah.revelationPlace %> · <%= surah.totalAyah %> Ayahs</p>
          </div>
          <span class="material-symbols-rounded surah-card-arrow">chevron_right</span>
        </a>
      <% } %>
    </div>
  </div>
</div>