<%# Shared favourites client, included by both /quran and /surah/:no.

    Expects a #quranFavConfig JSON script tag on the page with:
      { isLoggedIn: bool, keys: ["2:255", ...] }

    Exposes window.quranFavourites = { toggle, setHeart, isFavourite, syncHearts,
    load, keys }. Kept in a partial because the reader and the index were
    otherwise on separate copies that drifted. %>
<script id="quranFavConfig" type="application/json">
<%- JSON.stringify({ isLoggedIn: isLoggedIn, keys: favouriteKeys || [] }) %>
</script>

<script>
(function () {
  const configEl = document.getElementById('quranFavConfig');
  let config = { isLoggedIn: false, keys: [] };
  if (configEl) {
    try { config = JSON.parse(configEl.textContent) || config; } catch (e) {}
  }

  // A Set, because the reader can have one heart per ayah in a 286-ayah surah
  // and a linear scan on every paint is avoidable.
  let keys = new Set(config.keys || []);

  function keyOf(surahNo, ayahNo) { return surahNo + ':' + ayahNo; }

  function setHeart(button, on) {
    if (!button) return;
    button.classList.toggle('is-active', on);
    const icon = button.querySelector('.material-symbols-rounded');
    if (icon) icon.textContent = on ? 'favorite' : 'favorite_border';
    button.setAttribute('aria-pressed', String(on));
  }

  function paintAll() {
    document.querySelectorAll('[data-fav-surah]').forEach(function (button) {
      const key = keyOf(Number(button.dataset.favSurah), Number(button.dataset.favAyah));
      setHeart(button, keys.has(key));
    });
  }

  function updateBadge() {
    const el = document.getElementById('favouriteTabCount');
    if (el) el.textContent = keys.size;
    const body = document.getElementById('favouriteCount');
    if (body) body.textContent = keys.size;
  }

  function escapeHtml(value) {
    return String(value == null ? '' : value)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  async function toggle(surahNo, ayahNo) {
    if (!config.isLoggedIn) {
      // Favourites are account-only, so a guest is sent to sign in rather than
      // shown a star that would quietly vanish.
      window.location.href = '/login?returnTo=' + encodeURIComponent(window.location.pathname + window.location.search);
      return;
    }

    const key = keyOf(surahNo, ayahNo);
    const wasOn = keys.has(key);

    // Optimistic: the heart responds on the click, not after the round trip.
    document.querySelectorAll('[data-fav-surah="' + surahNo + '"][data-fav-ayah="' + ayahNo + '"]')
      .forEach(function (b) { setHeart(b, !wasOn); });
    if (wasOn) keys.delete(key); else keys.add(key);
    updateBadge();

    try {
      const response = await fetch('/quran/favourites/toggle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ surahNo: surahNo, ayahNo: ayahNo })
      });
      if (!response.ok) throw new Error('status ' + response.status);
      const data = await response.json();

      // The server is the authority: it may have rejected an out-of-range ayah,
      // in which case the optimistic guess was wrong.
      document.querySelectorAll('[data-fav-surah="' + surahNo + '"][data-fav-ayah="' + ayahNo + '"]')
        .forEach(function (b) { setHeart(b, data.favorited); });
      if (data.favorited) keys.add(key); else keys.delete(key);
      updateBadge();
    } catch (err) {
      document.querySelectorAll('[data-fav-surah="' + surahNo + '"][data-fav-ayah="' + ayahNo + '"]')
        .forEach(function (b) { setHeart(b, wasOn); });
      if (wasOn) keys.add(key); else keys.delete(key);
      updateBadge();
    }
  }

  async function load() {
    if (!config.isLoggedIn) return;
    const body = document.getElementById('favouritesBody');
    if (!body) return;
    try {
      const response = await fetch('/quran/favourites');
      if (!response.ok) return;
      const data = await response.json();
      const entries = data.entries || [];
      keys = new Set(entries.map((f) => keyOf(f.surahNo, f.ayahNo)));
      updateBadge();
      paintAll();

      if (!entries.length) {
        body.innerHTML = '<p class="post-empty">No saved ayahs yet. Tap the heart beside any ayah while reading.</p>';
        return;
      }

      body.innerHTML = entries.map(function (f) {
        const head =
          '<a class="favourite-ref" href="/surah/' + f.surahNo + '?ayah=' + f.ayahNo + '">'
          + escapeHtml(f.surahName)
          + (f.surahNameArabic ? ' · ' + escapeHtml(f.surahNameArabic) : '')
          + '</a><span class="favourite-num">Ayah ' + f.ayahNo + '</span>'
          + '<button type="button" class="favourite-remove" data-fav-surah="' + f.surahNo + '" data-fav-ayah="' + f.ayahNo + '"'
          + ' title="Remove from favourites" aria-label="Remove from favourites">'
          + '<span class="material-symbols-rounded">favorite</span></button>';

        let inner;
        if (f.unavailable) {
          inner = '<p class="favourite-missing">This ayah could not be loaded just now.</p>';
        } else {
          inner = '<p class="favourite-arabic" dir="rtl" lang="ar">' + escapeHtml(f.arabicText) + '</p>';
          if (f.translationText) {
            if (f.translationLabel) inner += '<p class="favourite-edition">' + escapeHtml(f.translationLabel) + '</p>';
            inner += '<p class="favourite-translation">' + escapeHtml(f.translationText) + '</p>';
          }
        }
        return '<article class="favourite-card"><header class="favourite-head">' + head + '</header>' + inner + '</article>';
      }).join('');
    } catch (err) {
      // Leave the server-rendered list rather than blanking the panel.
    }
  }

  window.quranFavourites = {
    toggle: toggle,
    setHeart: setHeart,
    paintAll: paintAll,
    load: load,
    isFavourite: function (s, a) { return keys.has(keyOf(s, a)); },
    size: function () { return keys.size; }
  };

  // Delegated: hearts are inside per-ayah markup and the favourites list is
  // rewritten wholesale, so per-element listeners would not survive.
  document.addEventListener('click', function (event) {
    const button = event.target.closest('[data-fav-surah]');
    if (!button) return;
    event.preventDefault();
    toggle(Number(button.dataset.favSurah), Number(button.dataset.favAyah));
  });

  paintAll();
})();
</script>